# Server
PORT=3000

# MySQL / MariaDB (SCADA DB History)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scada_history

# Polling interval in milliseconds (default: 30000 = 30 seconds)
POLLING_INTERVAL_MS=30000

# WHA Center — device_id per region UP3
WHACENTER_DEVICE_ID_TIMIKA_BIAK=your_device_id_1
WHACENTER_DEVICE_ID_MANOKWARI_NABIRE=your_device_id_2
WHACENTER_DEVICE_ID_SORONG_FAKFAK=your_device_id_3
WHACENTER_DEVICE_ID_JAYAPURA_WAMENA=your_device_id_4
WHACENTER_BASE_URL=https://api.whacenter.com

# Target grup WA per UP3 — group ID dari WHA Center (dikirim via field "number", pisahkan koma jika lebih dari satu)
WA_GROUP_TARGETS_TIMIKA=
WA_GROUP_TARGETS_BIAK=
WA_GROUP_TARGETS_MANOKWARI=
WA_GROUP_TARGETS_NABIRE=
WA_GROUP_TARGETS_SORONG=
WA_GROUP_TARGETS_FAKFAK=
WA_GROUP_TARGETS_JAYAPURA=
WA_GROUP_TARGETS_WAMENA=

# Target nomor individu per UP3 — format: 628xxxxxxxxxx (pisahkan koma jika lebih dari satu)
WA_NUMBER_TARGETS_TIMIKA=
WA_NUMBER_TARGETS_BIAK=
WA_NUMBER_TARGETS_MANOKWARI=
WA_NUMBER_TARGETS_NABIRE=
WA_NUMBER_TARGETS_SORONG=
WA_NUMBER_TARGETS_FAKFAK=
WA_NUMBER_TARGETS_JAYAPURA=
WA_NUMBER_TARGETS_WAMENA=
